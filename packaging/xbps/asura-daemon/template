# Template file for 'toren-daemon'
pkgname=toren-daemon
version=0.1
revision=1
hostmakedepends="go"
depends="seatd turnstile"
short_desc="Toren Linux control plane, session daemons, and apm package manager"
maintainer="Toren OS Project <dev@torenos.dev>"
license="GPL-3.0-only"
homepage="https://torenos.dev"

do_build() {
	mkdir -p bin
	(
		cd desktop
		CGO_ENABLED=0 go build -o ../bin/toren ./cmd/toren
		CGO_ENABLED=0 go build -o ../bin/toren-agent ./cmd/toren-agent
		CGO_ENABLED=0 go build -o ../bin/toren-sysd ./cmd/toren-sysd
		CGO_ENABLED=0 go build -o ../bin/toren-userd ./cmd/toren-userd
		CGO_ENABLED=0 go build -o ../bin/apm ./cmd/apm
	)
}

do_install() {
	vbin bin/toren
	vbin bin/toren-agent
	vbin bin/toren-sysd
	vbin bin/toren-userd
	vbin bin/apm

	vlicense LICENSE
	# Install session scripts and Wayland desktop entry
	vinstall session/toren-session 755 usr/share/toren/session
	vinstall session/toren-activate 755 usr/share/toren/session
	vinstall session/runit/toren-user-services 755 usr/bin
	vinstall system/helpers/prime-run 755 usr/bin
	vinstall installation/toren-installer.sh 755 usr/bin/toren-installer
	vinstall session/applications/toren-installer.desktop 644 usr/share/applications
	vinstall session/toren.desktop 644 usr/share/wayland-sessions

	# Install runit service templates
	vmkdir usr/share/toren/runit/services
	vcopy "system/runit/user-services/*" usr/share/toren/runit/services

	# Install local coding agent skills
	vmkdir usr/share/toren/shell/agent/skills/toren
	vcopy "shell/agent/skills/toren/*" usr/share/toren/shell/agent/skills/toren

	# Install system runit service (toren-sysd)
	vsv toren-sysd
}
