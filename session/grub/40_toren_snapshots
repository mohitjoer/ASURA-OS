#!/bin/sh
# Asura: emit a GRUB menuentry for every Btrfs snapshot in /.snapshots so a
# failed boot can be recovered by selecting one. Sourced by grub-mkconfig.
# Snapshots are read-only recovery images (the system boots read-only from
# one); run `asura rollback --system <name>` to make one the root for good.
# The snapshots live in the top-level subvolume @snapshots, mounted at
# /.snapshots, so the kernel is given rootflags=subvol=@snapshots/<name>.
set -e

. /usr/share/grub/grub-mkconfig_lib 2>/dev/null || true

prefix="/.snapshots"
[ -d "$prefix" ] || exit 0

# Latest kernel + initramfs, matching the main Asura entry.
kernel=$(ls /boot/vmlinuz-* 2>/dev/null | sort -V | tail -n 1)
[ -n "$kernel" ] || exit 0
kver=${kernel#/boot/vmlinuz-}
initrd="/boot/initramfs-${kver}.img"
[ -f "$initrd" ] || initrd="/boot/initrd.img-${kver}"
[ -f "$initrd" ] || exit 0

if [ -z "${GRUB_DEVICE_UUID:-}" ]; then
    GRUB_DEVICE_UUID=$(blkid -s UUID -o value "$(findmnt -n -o SOURCE / 2>/dev/null)" 2>/dev/null || true)
fi
[ -n "$GRUB_DEVICE_UUID" ] || exit 0

# GRUB_CMDLINE_LINUX carries what every boot needs (rd.luks.uuid=... on an
# encrypted install, so the root can be unlocked); _DEFAULT adds the quiet
# splash, as on the main entry.
cmdline="${GRUB_CMDLINE_LINUX:-} ${GRUB_CMDLINE_LINUX_DEFAULT:-loglevel=4 quiet splash}"

# How GRUB reaches the kernel, as 10_linux does: /boot is inside @ on a plain
# install and its own partition on an encrypted one, so the device and the
# path relative to it come from grub-mkconfig's own helpers, not a bare
# /boot/vmlinuz on the root partition.
grub_probe=${grub_probe:-grub-probe}
boot_device=$($grub_probe --target=device /boot 2>/dev/null || true)
access=""
if [ -n "$boot_device" ] && command -v prepare_grub_to_access_device >/dev/null 2>&1; then
    access=$(prepare_grub_to_access_device "$boot_device" | sed 's/^/    /')
fi
if command -v make_system_path_relative_to_its_root >/dev/null 2>&1; then
    kernel_path=$(make_system_path_relative_to_its_root "$kernel")
    initrd_path=$(make_system_path_relative_to_its_root "$initrd")
else
    kernel_path=$kernel
    initrd_path=$initrd
fi
[ -n "$access" ] || access="    search --no-floppy --fs-uuid --set=root $GRUB_DEVICE_UUID"

for snap in $(ls -1 "$prefix" 2>/dev/null | sort -r); do
    [ -d "$prefix/$snap" ] || continue
    cat <<EOF
menuentry "Toren Linux (snapshot $snap)" --class asura --class gnu-linux --class gnu --class os {
    load_video
    set gfxpayload=keep
    insmod gzio
    insmod part_gpt
    insmod btrfs
$access
    echo 'Loading Linux $kver (snapshot $snap)...'
    linux $kernel_path root=UUID=$GRUB_DEVICE_UUID ro rootflags=subvol=@snapshots/$snap $cmdline
    initrd $initrd_path
}
EOF
done
