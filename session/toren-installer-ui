#!/bin/sh
# Toren Linux interactive GUI installer launcher.
set -eu

QUICKSHELL_BIN=${ASURA_QUICKSHELL:-/usr/bin/quickshell}
ENTRY=/usr/share/toren/shell/installer.qml
LOCK="${XDG_RUNTIME_DIR:-/tmp}/toren-installer-ui.lock"

if [ ! -x "$QUICKSHELL_BIN" ]; then
    echo "toren-installer-ui: $QUICKSHELL_BIN is not installed." >&2
    exit 1
fi

if [ ! -f "$ENTRY" ]; then
    echo "toren-installer-ui: $ENTRY not found." >&2
    exit 1
fi

if command -v flock >/dev/null 2>&1; then
    exec 9>"$LOCK"
    flock -n 9 || exit 0
fi

exec "$QUICKSHELL_BIN" -p "$ENTRY"
