# Toren Safe Mode session registration.
#
# Packaged at /usr/share/toren/session/toren-safe.desktop and materialized to
# /usr/share/wayland-sessions/toren-safe.desktop.
# Provides a minimal rescue desktop in login managers (SDDM/GDM) with Hyprland
# and a terminal window, bypassing desktop shells, user configs, and plugins.

[Desktop Entry]
Type=Application
Name=Toren Linux (safe mode)
Comment=Toren Linux minimal recovery session
TryExec=/usr/share/toren/session/toren-session-safe
Exec=/usr/share/toren/session/toren-session-safe
DesktopNames=Toren
Keywords=Hyprland;Recovery;SafeMode;Toren;
