#!/bin/sh
# Asura Safe Mode Session Entry Point
# Minimal fallback desktop running Hyprland with safe-mode.conf
set -eu

LOG="${XDG_STATE_HOME:-$HOME/.local/state}/asura/session-safe.log"
mkdir -p "$(dirname "$LOG")"
exec >>"$LOG" 2>&1

echo "--- asura-session-safe $(date -Is)"

export XDG_SESSION_DESKTOP=asura
export XDG_CURRENT_DESKTOP=Asura
export DESKTOP_SESSION=asura
export XDG_SESSION_TYPE=wayland
export ASURA_SAFE_MODE=1

if [ -z "${LANG:-}" ] || [ "$LANG" = "C" ] || [ "$LANG" = "POSIX" ]; then
    export LANG="en_US.UTF-8"
fi
export LC_ALL="${LC_ALL:-$LANG}"

if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi
mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true

COMPOSITOR="${ASURA_COMPOSITOR:-}"
if [ -z "$COMPOSITOR" ]; then
    if command -v Hyprland >/dev/null 2>&1; then
        COMPOSITOR="Hyprland"
    elif command -v hyprland >/dev/null 2>&1; then
        COMPOSITOR="hyprland"
    elif [ -x /usr/bin/Hyprland ]; then
        COMPOSITOR="/usr/bin/Hyprland"
    fi
fi

if [ -z "$COMPOSITOR" ] || ( ! command -v "$COMPOSITOR" >/dev/null 2>&1 && [ ! -x "$COMPOSITOR" ] ); then
    echo "asura-session-safe: error: Hyprland compositor binary not found on system!" >&2
    exit 127
fi

# Lua from Hyprland 0.57, hyprlang (.conf) before: pick by the installed
# Hyprland, so safe mode starts even before Hyprland itself is updated.
hyprland_reads_lua() {
    hv=$(Hyprland --version 2>/dev/null | sed -n '1s/^Hyprland \([0-9][0-9.]*\).*/\1/p')
    [ -n "$hv" ] || return 1
    echo "$hv" | awk -F. '{ exit !($1 > 0 || ($1 == 0 && $2 >= 57)) }'
}
if [ -f "/usr/share/asura/safe-mode/hyprland.lua" ] && hyprland_reads_lua; then
    SAFE_CONF="${ASURA_SAFE_HYPRLAND_CONFIG:-/usr/share/asura/safe-mode/hyprland.lua}"
else
    SAFE_CONF="${ASURA_SAFE_HYPRLAND_CONFIG:-/usr/share/asura/safe-mode/hyprland.conf}"
fi
exec "$COMPOSITOR" -c "$SAFE_CONF" "$@"
