#!/bin/sh
# The screenshot tool: capture, annotate, copy or save.
#
# A wrapper for the same reason toren-hub is one: `quickshell -p` on the entry
# file is the whole program, and the entry file is at the shell's root so the
# `qs.*` imports resolve. The flock keeps one instance, so a second press of the
# key while the overlay is up does nothing instead of stacking a second overlay.
#
#	toren-shot                          region, or the window under the pointer
#	ASURA_SHOT_MODE=monitor toren-shot  a whole monitor
set -eu

QUICKSHELL_BIN=${ASURA_QUICKSHELL:-/usr/bin/quickshell}
ENTRY=/usr/share/toren/shell/shot.qml

# Software rendering in a virtual machine (one shared check):
GFX=/usr/share/toren/session/toren-graphics-env
# shellcheck source=/dev/null
if [ -r "$GFX" ]; then . "$GFX"; fi

if [ ! -x "$QUICKSHELL_BIN" ]; then
    echo "toren-shot: $QUICKSHELL_BIN is not installed." >&2
    echo "toren-shot: the editor is drawn by Quickshell, which Toren builds." >&2
    exit 1
fi

exec flock -n -o /tmp/toren-shot.lock "$QUICKSHELL_BIN" -p "$ENTRY"
