# Toren session registration.
#
# Packaged at /usr/share/toren/session/toren.desktop and materialized to
# /usr/share/wayland-sessions/toren.desktop, which is a registration on the
# sanctioned list: the login manager scans that fixed directory and nowhere else.
#
# Three lines carry the design, and each of them is load-bearing:
#
#   Exec=             the session entry point is Toren's own script, run from
#                     the packaged base rather than from a copy in the user's
#                     home, so a machine cannot be broken by editing it there
#   DesktopNames=     Toren, not GNOME. The login manager groups by this, and
#                     the portal dispatcher derives its per-desktop
#                     configuration file name from it. Anything else makes a
#                     display manager treat a Toren session as its own.
#   wayland-sessions  the directory decides the session type: XDG_SESSION_TYPE
#                     is wayland for a file here and x11 for one in xsessions.
[Desktop Entry]
Type=Application
Name=Toren
Comment=Toren Linux desktop
TryExec=/usr/share/toren/session/toren-session
Exec=/usr/share/toren/session/toren-session
DesktopNames=Toren
Keywords=Hyprland;Quickshell;Toren;
