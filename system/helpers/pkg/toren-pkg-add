#!/bin/sh
# Install or remove native packages with polkit's authority.
#
#   toren-pkg-add [--status] PACKAGE...
#   toren-pkg-add [--status] --remove PACKAGE...    (toren-pkg-remove does this)
#
# Run as an ordinary user it asks pkexec to run this same file as root, so the
# shell's polkit agent shows the prompt and no terminal or sudo is involved.
set -eu

self=$(readlink -f "$0")
status=0
remove=0
for arg; do
    case $arg in
        --status) status=1; shift ;;
        --remove) remove=1; shift ;;
        *) break ;;
    esac
done
[ $# -gt 0 ] || { echo "toren-pkg-add: no packages given" >&2; exit 2; }

# Package names validation
for p; do
    case $p in
        -*|*[!a-zA-Z0-9+._-]*) echo "toren-pkg-add: '$p' is not a package name" >&2; exit 2 ;;
    esac
done

if [ "$(id -u)" -ne 0 ]; then
    flags=""
    [ $status -eq 0 ] || flags="$flags --status"
    [ $remove -eq 0 ] || flags="$flags --remove"
    exec pkexec "$self" $flags "$@"
fi

# Run as root
trap '' PIPE HUP
# A system snapshot first, so a bad install or removal can be rolled back
# (toren rollback --system). Skipped quietly when / is not Btrfs.
if command -v toren >/dev/null 2>&1; then
    toren snapshot create --reason install >/dev/null 2>&1 || true
fi
if [ $remove -eq 1 ]; then
    exec xbps-remove -y "$@"
else
    exec xbps-install -y "$@"
fi
