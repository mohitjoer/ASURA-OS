#!/bin/sh
exec 2>&1
# The session bus (the dbus user service): wait for it, so this service does
# not start on no bus.
_bus="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus"
_i=0
while [ ! -S "$_bus" ] && [ "$_i" -lt 50 ]; do sleep 0.2; _i=$((_i + 1)); done
# Start without it rather than not at all: a missing bus costs the services
# that need it, but never the whole desktop.
if [ -S "$_bus" ]; then
	export DBUS_SESSION_BUS_ADDRESS="unix:path=$_bus"
else
	echo "no session bus at $_bus after 10 s; starting without it"
fi
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export XDG_RUNTIME_DIR="$RUNTIME_DIR"

# Resolve WAYLAND_DISPLAY from runtime socket if empty
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
	for sock in "$RUNTIME_DIR"/wayland-[0-9]*; do
		if [ -S "$sock" ]; then
			export WAYLAND_DISPLAY="$(basename "$sock")"
			break
		fi
	done
fi

# Resolve HYPRLAND_INSTANCE_SIGNATURE from runtime dir if empty
if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && [ -d "$RUNTIME_DIR/hypr" ]; then
	for sig_dir in $(ls -td "$RUNTIME_DIR"/hypr/*_* 2>/dev/null); do
		if [ -S "$sig_dir/.socket.sock" ]; then
			export HYPRLAND_INSTANCE_SIGNATURE="$(basename "$sig_dir")"
			break
		fi
	done
fi
EXE=""
for p in /usr/libexec/xdg-desktop-portal-hyprland /usr/lib/xdg-desktop-portal-hyprland /usr/bin/xdg-desktop-portal-hyprland /usr/lib64/xdg-desktop-portal-hyprland; do
	if [ -x "$p" ]; then
		EXE="$p"
		break
	fi
done
if [ -z "$EXE" ]; then
	echo "xdg-desktop-portal-hyprland not found" >&2
	exit 1
fi
exec "$EXE"
