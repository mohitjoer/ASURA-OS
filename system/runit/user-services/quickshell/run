#!/bin/sh

exec 2>&1
# The session bus (the dbus user service): wait for it, so this service does
# not start on no bus; runit starts it again until the bus is there.
_bus="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus"
_i=0
while [ ! -S "$_bus" ] && [ "$_i" -lt 50 ]; do sleep 0.2; _i=$((_i + 1)); done
[ -S "$_bus" ] || { echo "waiting for the session bus at $_bus"; exit 1; }
export DBUS_SESSION_BUS_ADDRESS="unix:path=$_bus"

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export XDG_RUNTIME_DIR="$RUNTIME_DIR"
export QT_QPA_PLATFORM=wayland
export XDG_CURRENT_DESKTOP=Toren
export XDG_SESSION_DESKTOP=toren
export DESKTOP_SESSION=toren
export GDK_BACKEND=wayland
# What a Wayland session's apps expect, for anything the shell starts itself:
# this runs under a runit supervisor that can start before the compositor,
# with none of the session's environment.
export XDG_SESSION_TYPE=wayland
export MOZ_ENABLE_WAYLAND=1

# Resolve WAYLAND_DISPLAY from runtime socket if empty or invalid
for _ in $(seq 1 50); do
	if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "$RUNTIME_DIR/$WAYLAND_DISPLAY" ]; then
		break
	fi
	for sock in "$RUNTIME_DIR"/wayland-[0-9]*; do
		if [ -S "$sock" ]; then
			export WAYLAND_DISPLAY="$(basename "$sock")"
			break 2
		fi
	done
	sleep 0.1
done

# Resolve HYPRLAND_INSTANCE_SIGNATURE from runtime dir if empty or invalid
for _ in $(seq 1 50); do
	if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && [ -S "$RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket.sock" ]; then
		break
	fi
	for sig_dir in $(ls -td "$RUNTIME_DIR"/hypr/*_* 2>/dev/null); do
		if [ -S "$sig_dir/.socket.sock" ]; then
			export HYPRLAND_INSTANCE_SIGNATURE="$(basename "$sig_dir")"
			break 2
		fi
	done
	sleep 0.1
done

LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/toren"
mkdir -p "$LOG_DIR"
exec >>"$LOG_DIR/quickshell.log" 2>&1

# Which desktop shell: org.toren.shell desktop-shell picks Toren's own shell
# (toren) or the desktop shell (desktop). TOREN_DESKTOP_SHELL
# overrides it for a test run, and TOREN_SHELL_DIR overrides the directory.
DESKTOP_SHELL="${TOREN_DESKTOP_SHELL:-${ASURA_DESKTOP_SHELL:-$(gsettings get org.toren.shell desktop-shell 2>/dev/null | tr -d "'")}}"
DESKTOP_SHELL="${DESKTOP_SHELL:-desktop}"

# The desktop is the default shell. Toren's own shell runs only when the user chooses it
# (org.toren.shell desktop-shell = toren); it is never switched to on its own.
# When the desktop exits within 15 seconds three times in a row, it is restarted
# after a pause instead, so a crash loop does not spin the CPU, and the user
# is told once where the log is.
CRASHES="$LOG_DIR/desktop-quick-exits"
if [ "$DESKTOP_SHELL" = "desktop" ]; then
	now=$(date +%s)
	last=$(cat "$LOG_DIR/desktop-last-start" 2>/dev/null || echo 0)
	count=$(cat "$CRASHES" 2>/dev/null || echo 0)
	if [ "$last" -gt 0 ] && [ $((now - last)) -lt 15 ]; then
		count=$((count + 1))
	else
		count=0
	fi
	echo "$count" >"$CRASHES"
	if [ "$count" -ge 3 ]; then
		echo "quickshell: the desktop exited within 15s $count times in a row; restarting it in 5s" >&2
		if [ "$count" -eq 3 ] && command -v notify-send >/dev/null 2>&1; then
			notify-send -a "Toren Linux" "The desktop keeps restarting" "See ~/.local/state/toren/quickshell.log" 2>/dev/null || true
		fi
		sleep 5
	fi
	date +%s >"$LOG_DIR/desktop-last-start"
fi

case "$DESKTOP_SHELL" in
	desktop) DEFAULT_DIR=/usr/share/toren/shell-desktop ;;
	*) DEFAULT_DIR=/usr/share/toren/shell ;;
esac
SHELL_DIR="${TOREN_SHELL_DIR:-${ASURA_SHELL_DIR:-$DEFAULT_DIR}}"
if [ ! -f "$SHELL_DIR/shell.qml" ]; then
	echo "quickshell: $SHELL_DIR/shell.qml is missing; reinstall with: toren update --force" >&2
	sleep 10
	exit 1
fi
echo "quickshell: starting the $DESKTOP_SHELL desktop from $SHELL_DIR"

if ! command -v quickshell >/dev/null 2>&1 && [ ! -x /usr/bin/quickshell ]; then
	echo "quickshell: binary not found; desktop shell unavailable" >&2
	sleep 10
	exit 1
fi

# Virtual machine graphics fallback:
# Under virtualized GPU drivers (vmwgfx / VirtualBox VMSVGA), QtWayland fails
# to allocate hardware EGL surfaces for layer-shell surfaces (producing
# "wl_display error 1: invalid arguments for wl_surface.attach").
# Force software OpenGL for Quickshell in VMs so the desktop bar and dock render reliably.
if [ -z "${LIBGL_ALWAYS_SOFTWARE:-}" ]; then
	if [ -n "${TOREN_IS_VM:-${ASURA_IS_VM:-}}" ] || \
	   grep -qa "VirtualBox\|VMware\|QEMU\|KVM" /sys/class/dmi/id/product_name 2>/dev/null || \
	   grep -qa "VirtualBox\|VMware\|QEMU\|KVM\|innotek" /sys/class/dmi/id/sys_vendor 2>/dev/null || \
	   lspci 2>/dev/null | grep -qi "VMware\|VirtualBox\|QEMU"; then
		export LIBGL_ALWAYS_SOFTWARE=1
	fi
fi

# Ensure desktop shell runs from user home so child processes (terminals, apps) start in $HOME
cd "$HOME" 2>/dev/null || true

exec quickshell -p "$SHELL_DIR"
