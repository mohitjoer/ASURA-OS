#!/bin/sh
exec 2>&1
# The session bus (the dbus user service): wait for it, so this service does
# not start on no bus.
_bus="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus"
_i=0
while [ ! -S "$_bus" ] && [ "$_i" -lt 50 ]; do sleep 0.2; _i=$((_i + 1)); done
# Start without it rather than not at all: a missing bus costs the services
# that need it, but never the whole desktop.
if [ -S "$_bus" ]; then
	export DBUS_SESSION_BUS_ADDRESS="unix:path=$_bus"
else
	echo "no session bus at $_bus after 10 s; starting without it"
fi

# Resolve WAYLAND_DISPLAY from runtime socket if empty or invalid
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
for _ in $(seq 1 50); do
	if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "$RUNTIME_DIR/$WAYLAND_DISPLAY" ]; then
		break
	fi
	for sock in "$RUNTIME_DIR"/wayland-[0-9]*; do
		if [ -S "$sock" ]; then
			export WAYLAND_DISPLAY="$(basename "$sock")"
			break 2
		fi
	done
	sleep 0.1
done

# Software rendering in a virtual machine (one shared check):
GFX=/usr/share/toren/session/toren-graphics-env
# shellcheck source=/dev/null
if [ -r "$GFX" ]; then . "$GFX"; fi

LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/toren"
mkdir -p "$LOG_DIR"
exec >>"$LOG_DIR/toren-idle.log" 2>&1

# In live ISO installer sessions, avoid locking out the user
if [ -f /etc/toren-live ] || grep -qE "boot=live|live" /proc/cmdline 2>/dev/null; then
	exec sleep infinity
fi

if [ -x /usr/share/toren/session/toren-idle ]; then
	exec /usr/share/toren/session/toren-idle start
fi

if [ -f "$HOME/.config/toren/hyprland/hypridle.conf" ]; then
	exec hypridle -c "$HOME/.config/toren/hyprland/hypridle.conf"
elif [ -f /usr/share/toren/hyprland/hypridle.conf ]; then
	exec hypridle -c /usr/share/toren/hyprland/hypridle.conf
fi
exec hypridle
