#!/bin/sh
# Tells the desktop when an ASURA update is available or a reboot would
# finish one (toren notify-updates), once per new update or kernel. Checks 10
# minutes after login, then every 6 hours. It only reads: nothing is installed
# until the user runs toren update.
exec 2>&1
# The session bus (the dbus user service): wait for it, so this service does
# not start on no bus.
_bus="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus"
_i=0
while [ ! -S "$_bus" ] && [ "$_i" -lt 50 ]; do sleep 0.2; _i=$((_i + 1)); done
# Start without it rather than not at all: a missing bus costs the services
# that need it, but never the whole desktop.
if [ -S "$_bus" ]; then
	export DBUS_SESSION_BUS_ADDRESS="unix:path=$_bus"
else
	echo "no session bus at $_bus after 10 s; starting without it"
fi

LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/toren"
mkdir -p "$LOG_DIR"
exec >>"$LOG_DIR/toren-updates.log" 2>&1

# The live ISO has nothing to update.
if [ -f /etc/toren-live ] || grep -qw "boot=live" /proc/cmdline 2>/dev/null; then
	exec sleep infinity
fi

sleep 600
while :; do
	toren notify-updates || true
	sleep 21600
done
