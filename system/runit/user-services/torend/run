#!/bin/sh
exec 2>&1
# The session bus (the dbus user service): wait for it, so this service does
# not start on no bus; runit starts it again until the bus is there.
_bus="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/bus"
_i=0
while [ ! -S "$_bus" ] && [ "$_i" -lt 50 ]; do sleep 0.2; _i=$((_i + 1)); done
[ -S "$_bus" ] || { echo "waiting for the session bus at $_bus"; exit 1; }
export DBUS_SESSION_BUS_ADDRESS="unix:path=$_bus"

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export XDG_RUNTIME_DIR="$RUNTIME_DIR"
# The session has one polkit agent. ASURA's own shell draws the daemon's
# prompt, so the daemon registers when that shell runs; the desktop has
# its own agent and prompt (modules/ii/polkit), so the daemon stays out of its
# way. Read the same setting the shell service reads.
case "${ASURA_DESKTOP_SHELL:-$(gsettings get org.toren.shell desktop-shell 2>/dev/null | tr -d "'")}" in
	toren) export ASURA_POLKIT_AGENT=1 ;;
	*) export ASURA_POLKIT_AGENT=0 ;;
esac

# The daemon spawns graphical tools (hyprlock) and talks to the compositor
# (hyprctl). Services under turnstile's runsvdir start with a minimal
# environment, so the display is resolved here the way every other session
# service resolves it, instead of trusting the inherited environment.
if [ -z "${WAYLAND_DISPLAY:-}" ]; then
	for sock in "$RUNTIME_DIR"/wayland-[0-9]*; do
		[ -S "$sock" ] || continue
		export WAYLAND_DISPLAY="$(basename "$sock")"
		break
	done
fi
if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && [ -d "$RUNTIME_DIR/hypr" ]; then
	for sig_dir in $(ls -td "$RUNTIME_DIR"/hypr/*_* 2>/dev/null); do
		[ -S "$sig_dir/.socket.sock" ] || continue
		export HYPRLAND_INSTANCE_SIGNATURE="$(basename "$sig_dir")"
		break
	done
fi

LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/toren"
mkdir -p "$LOG_DIR"
exec >>"$LOG_DIR/torend.log" 2>&1

exec /usr/bin/toren-shell daemon
